--- /dev/null
+++ b/tests/test_manager_delegation_budget.py
@@ -0,0 +1,91 @@
+"""Native, provider-free checks for opt-in per-task manager delegation limits."""
+
+import unittest
+
+from agentlite.agents import ABCAgent, ManagerAgent
+from agentlite.commons import TaskPackage
+
+
+class ScriptedLLM:
+    def __init__(self, *actions):
+        self.actions = iter(actions)
+
+    def run(self, prompt):
+        return next(self.actions)
+
+
+class QuietLogger:
+    def __getattr__(self, name):
+        return lambda *args, **kwargs: None
+
+
+class RecordingWorker(ABCAgent):
+    def __init__(self):
+        super().__init__(name="Worker", role="Handle delegated task")
+        self.calls = []
+
+    def __call__(self, task):
+        self.calls.append(task.instruction)
+        return "done"
+
+
+def manager_with_actions(*actions, limit=None):
+    worker = RecordingWorker()
+    options = {}
+    if limit is not None:
+        options["max_team_calls_per_task"] = limit
+    manager = ManagerAgent(
+        llm=ScriptedLLM(*actions),
+        TeamAgents=[worker],
+        logger=QuietLogger(),
+        **options,
+    )
+    return manager, worker
+
+
+def task_with_id(task_id):
+    return TaskPackage(instruction="run", task_id=task_id)
+
+
+class ManagerDelegationBudgetTests(unittest.TestCase):
+    def test_opt_in_limit_prevents_second_worker_execution(self):
+        manager, worker = manager_with_actions(
+            'Worker[{"Task":"first"}]',
+            'Worker[{"Task":"second"}]',
+            'Finish[{"response":"complete"}]',
+            limit=1,
+        )
+        task = task_with_id("budgeted")
+        self.assertEqual(manager(task), "complete")
+        self.assertEqual(worker.calls, ["first"])
+        observations = manager.short_term_memory.get_action_chain(task)
+        self.assertIn("limit", observations[1][1].lower())
+
+    def test_legacy_default_keeps_both_delegations(self):
+        manager, worker = manager_with_actions(
+            'Worker[{"Task":"first"}]',
+            'Worker[{"Task":"second"}]',
+            'Finish[{"response":"complete"}]',
+        )
+        self.assertEqual(manager(task_with_id("legacy")), "complete")
+        self.assertEqual(worker.calls, ["first", "second"])
+
+    def test_budget_resets_for_new_task_on_same_manager(self):
+        manager, worker = manager_with_actions(
+            'Worker[{"Task":"first"}]',
+            'Finish[{"response":"one"}]',
+            'Worker[{"Task":"second"}]',
+            'Finish[{"response":"two"}]',
+            limit=1,
+        )
+        self.assertEqual(manager(task_with_id("one")), "one")
+        self.assertEqual(manager(task_with_id("two")), "two")
+        self.assertEqual(worker.calls, ["first", "second"])
+
+    def test_negative_budget_is_rejected(self):
+        with self.assertRaises(ValueError):
+            manager_with_actions('Finish[{"response":"done"}]', limit=-1)
+
+
+if __name__ == "__main__":
+    unittest.main()
