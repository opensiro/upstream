diff --git a/scripts/native-sandbox-timeout.test.mjs b/scripts/native-sandbox-timeout.test.mjs
new file mode 100644
index 0000000..94a400a
--- /dev/null
+++ b/scripts/native-sandbox-timeout.test.mjs
@@ -0,0 +1,31 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { runInSandbox } from '../sifra/sandbox.ts';
+
+test('native inline script can invoke a permitted tool before deadline', async () => {
+  const calls = [];
+  const result = await runInSandbox('tools.record("ok"); return 1;', {
+    record: value => calls.push(value),
+  }, { timeoutMs: 100 });
+  assert.equal(result.ok, true);
+  assert.deepEqual(calls, ['ok']);
+});
+
+test('async task that exceeds the deadline reports a timeout', async () => {
+  const result = await runInSandbox('await tools.wait(); return 1;', {
+    wait: () => new Promise(resolve => setTimeout(resolve, 35)),
+  }, { timeoutMs: 5 });
+  assert.equal(result.ok, false);
+  assert.match(result.error, /timed out/);
+});
+
+test('timed-out code cannot call another host tool after being rejected', async () => {
+  const effects = [];
+  const result = await runInSandbox('await tools.wait(); tools.record("late");', {
+    wait: () => new Promise(resolve => setTimeout(resolve, 35)),
+    record: value => effects.push(value),
+  }, { timeoutMs: 5 });
+  assert.equal(result.ok, false);
+  await new Promise(resolve => setTimeout(resolve, 65));
+  assert.deepEqual(effects, []);
+});
