@@ -0,0 +1,108 @@
+"""Offline checkpoint preflight: no model, box, or MCP service is needed."""
+
+import json
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+from harness.checkpoints.inspection import inspect_checkpoint_file
+
+
+def _write_checkpoint(tmp_path, **changes):
+    path = tmp_path / "checkpoint.json"
+    record = {
+        "kind": "yaml_agent_checkpoint",
+        "schema_version": 1,
+        "task_name": "demo",
+        "completed_steps": ["1", "2"],
+        "run_id": "run-1",
+    }
+    record.update(changes)
+    path.write_text(json.dumps(record), encoding="utf-8")
+    return path
+
+
+def test_valid_checkpoint_reports_completed_steps_without_modifying_file(tmp_path):
+    checkpoint = _write_checkpoint(tmp_path)
+    original = checkpoint.read_bytes()
+    report = inspect_checkpoint_file(checkpoint, expected_task_name="demo", expected_steps=3)
+    assert report["valid"] is True
+    assert report["reason_codes"] == []
+    assert report["completed_steps"] == 2
+    assert checkpoint.read_bytes() == original
+
+
+@pytest.mark.parametrize(
+    ("change", "code"),
+    [
+        ({"kind": "other"}, "CHECKPOINT_KIND_MISMATCH"),
+        ({"schema_version": 99}, "SCHEMA_VERSION_MISMATCH"),
+        ({"completed_steps": "1,2"}, "INVALID_COMPLETED_STEPS"),
+        ({"completed_steps": ["1", "1"]}, "DUPLICATE_COMPLETED_STEPS"),
+        ({"completed_steps": ["1", "4"]}, "STEP_OUT_OF_RANGE"),
+    ],
+)
+def test_unsafe_checkpoint_rejected_with_machine_reason(tmp_path, change, code):
+    checkpoint = _write_checkpoint(tmp_path, **change)
+    report = inspect_checkpoint_file(checkpoint, expected_task_name="demo", expected_steps=3)
+    assert report["valid"] is False
+    assert code in report["reason_codes"]
+
+
+def test_unknown_task_rejected(tmp_path):
+    report = inspect_checkpoint_file(_write_checkpoint(tmp_path), expected_task_name="other")
+    assert report["reason_codes"] == ["TASK_NAME_MISMATCH"]
+
+
+def test_malformed_json_is_reported_without_recovery_side_effect(tmp_path):
+    checkpoint = tmp_path / "checkpoint.json"
+    checkpoint.write_text("{oops", encoding="utf-8")
+    report = inspect_checkpoint_file(checkpoint)
+    assert report["reason_codes"] == ["CHECKPOINT_INVALID_JSON"]
+    assert not list(tmp_path.glob("*.corrupted"))
+
+
+def test_missing_checkpoint_is_reported_without_creating_a_new_file(tmp_path):
+    checkpoint = tmp_path / "missing.json"
+    report = inspect_checkpoint_file(checkpoint)
+    assert report["reason_codes"] == ["CHECKPOINT_NOT_FOUND"]
+    assert not checkpoint.exists()
+
+
+def test_optional_completed_step_output_presence(tmp_path):
+    checkpoint = _write_checkpoint(tmp_path)
+    (tmp_path / "step-1-output.txt").write_text("done", encoding="utf-8")
+    report = inspect_checkpoint_file(checkpoint, require_step_outputs=True)
+    assert report["reason_codes"] == ["STEP_OUTPUT_MISSING"]
+    assert report["missing_output_steps"] == ["2"]
+    assert inspect_checkpoint_file(checkpoint)["valid"] is True
+
+
+def test_nested_substeps_are_not_required_to_have_top_level_output_files(tmp_path):
+    checkpoint = _write_checkpoint(tmp_path, completed_steps=["1.1", "1.2"])
+    assert inspect_checkpoint_file(checkpoint, expected_steps=2, require_step_outputs=True)["valid"]
+
+
+def test_public_cli_inspection_pass_and_fail_without_running_agents(tmp_path):
+    valid_checkpoint = _write_checkpoint(tmp_path)
+    env = dict(os.environ, PYTHONPATH=str(Path(__file__).parents[2] / "src"))
+    command = [
+        sys.executable,
+        "-m",
+        "harness.ephemeral.cli",
+        "inspect-checkpoint",
+        str(valid_checkpoint),
+        "--expected_task_name=demo",
+        "--expected_steps=3",
+    ]
+    passed = subprocess.run(command, capture_output=True, text=True, env=env)
+    assert passed.returncode == 0, passed.stderr
+    assert json.loads(passed.stdout)["valid"] is True
+
+    _write_checkpoint(tmp_path, kind="wrong")
+    rejected = subprocess.run(command, capture_output=True, text=True, env=env)
+    assert rejected.returncode == 2, rejected.stderr
+    assert "CHECKPOINT_KIND_MISMATCH" in json.loads(rejected.stdout)["reason_codes"]
