+"""Read-only checkpoint preflight: never runs a model, box, or MCP service."""
+
+import json
+from pathlib import Path
+from typing import Any, Optional
+
+from ..types.context import CHECKPOINT_KIND, CHECKPOINT_SCHEMA_VERSION
+
+
+def inspect_checkpoint_file(
+    checkpoint_path: str | Path,
+    *,
+    expected_task_name: Optional[str] = None,
+    expected_steps: Optional[int] = None,
+    require_step_outputs: bool = False,
+) -> dict[str, Any]:
+    """Check saved YAML-run state without mutating files.
+
+    The optional step-output check is conservative: some control-only steps
+    intentionally lack a file. Nested step ids do not require top-level files.
+    This is a structural check, not provenance or agent-quality verification.
+    """
+    if expected_steps is not None and (
+        isinstance(expected_steps, bool)
+        or not isinstance(expected_steps, int)
+        or expected_steps < 0
+    ):
+        raise ValueError("expected_steps must be a non-negative integer")
+
+    path = Path(checkpoint_path)
+    reasons: list[str] = []
+    missing_outputs: list[str] = []
+    report: dict[str, Any] = {
+        "checkpoint": str(path),
+        "valid": False,
+        "reason_codes": reasons,
+        "completed_steps": 0,
+        "missing_output_steps": missing_outputs,
+    }
+
+    try:
+        contents = path.read_text(encoding="utf-8")
+    except FileNotFoundError:
+        reasons.append("CHECKPOINT_NOT_FOUND")
+        return report
+    except (OSError, UnicodeError):
+        reasons.append("CHECKPOINT_UNREADABLE")
+        return report
+
+    try:
+        data = json.loads(contents)
+    except json.JSONDecodeError:
+        reasons.append("CHECKPOINT_INVALID_JSON")
+        return report
+    if not isinstance(data, dict):
+        reasons.append("CHECKPOINT_INVALID_ROOT")
+        return report
+
+    if data.get("kind") != CHECKPOINT_KIND:
+        reasons.append("CHECKPOINT_KIND_MISMATCH")
+    if data.get("schema_version") != CHECKPOINT_SCHEMA_VERSION:
+        reasons.append("SCHEMA_VERSION_MISMATCH")
+    if expected_task_name is not None and data.get("task_name") != expected_task_name:
+        reasons.append("TASK_NAME_MISMATCH")
+
+    steps = data.get("completed_steps", [])
+    if not isinstance(steps, list) or any(
+        isinstance(step, bool) or not isinstance(step, (str, int)) or not str(step)
+        for step in (steps if isinstance(steps, list) else [])
+    ):
+        reasons.append("INVALID_COMPLETED_STEPS")
+    else:
+        completed = [str(step) for step in steps]
+        report["completed_steps"] = len(completed)
+        if len(completed) != len(set(completed)):
+            reasons.append("DUPLICATE_COMPLETED_STEPS")
+        if expected_steps is not None:
+            for step_id in completed:
+                head = step_id.split(".", 1)[0]
+                if not head.isdecimal() or not 1 <= int(head) <= expected_steps:
+                    reasons.append("STEP_OUT_OF_RANGE")
+                    break
+        if require_step_outputs:
+            for step_id in completed:
+                if step_id.isdecimal() and not (
+                    path.parent / f"step-{step_id}-output.txt"
+                ).is_file():
+                    missing_outputs.append(step_id)
+            if missing_outputs:
+                reasons.append("STEP_OUTPUT_MISSING")
+    report["valid"] = not reasons
+    return report
