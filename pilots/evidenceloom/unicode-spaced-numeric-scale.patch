@@ -0,0 +1,39 @@
+"""Offline native checks for Unicode-spaced percent-scale suffixes."""
+
+import unittest
+
+from tradingagents.research.numeric_spans import _SectionSpans, supported_numeric_span
+
+
+def selection(text):
+    start = len("Yield ".encode("utf-8"))
+    return {"start_byte": start, "end_byte": start + 2, "text": "12"}
+
+
+class ScaleWhitespaceTests(unittest.TestCase):
+    def check_both(self, text, expected):
+        span = selection(text)
+        self.assertEqual(supported_numeric_span(text, span), expected)
+        self.assertEqual(_SectionSpans(text).numeric(span), expected)
+
+    def test_narrow_nbsp_percent_is_scaled(self):
+        self.check_both("Yield 12\u202f% today", False)
+
+    def test_nbsp_percent_is_scaled(self):
+        self.check_both("Yield 12\u00a0% today", False)
+
+    def test_thin_space_percent_is_scaled(self):
+        self.check_both("Yield 12\u2009% today", False)
+
+    def test_ascii_space_percent_is_scaled(self):
+        self.check_both("Yield 12 % today", False)
+
+    def test_immediate_percent_is_scaled(self):
+        self.check_both("Yield 12% today", False)
+
+    def test_non_scale_plain_number_is_still_supported(self):
+        self.check_both("Yield 12 USD today", True)
+
+
+if __name__ == "__main__":
+    unittest.main()
