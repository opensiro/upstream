@@ -0,0 +1,45 @@
+"""Native path-contract checks only; no proposer, substrate or agent execution."""
+
+import tempfile
+import unittest
+from pathlib import Path
+
+from harness2.core.library import Library, domain_dir, slug
+
+
+class LibraryPathComponents(unittest.TestCase):
+    def test_regular_task_id_slash_is_still_flattened(self):
+        self.assertEqual(slug("project/issue"), "project__issue")
+
+    def test_windows_separator_is_also_flattened(self):
+        self.assertEqual(slug("project\\issue"), "project__issue")
+
+    def test_regular_domain_separator_is_still_flattened(self):
+        self.assertEqual(domain_dir("ops / tools"), "ops__tools")
+
+    def test_dot_task_name_cannot_alias_harnesses_directory(self):
+        with self.assertRaises(ValueError):
+            slug(".")
+
+    def test_dotdot_task_name_cannot_alias_parent_directory(self):
+        with self.assertRaises(ValueError):
+            slug("..")
+
+    def test_empty_task_name_cannot_alias_harnesses_directory(self):
+        with self.assertRaises(ValueError):
+            slug("")
+
+    def test_domain_parent_component_is_rejected(self):
+        with self.assertRaises(ValueError):
+            domain_dir(" .. ")
+
+    def test_library_rejects_invalid_entry_before_any_mutation(self):
+        with tempfile.TemporaryDirectory(prefix="harness2-library-test-") as tmp:
+            library = Library(root=Path(tmp), domain="safe", surface=None)
+            with self.assertRaises(ValueError):
+                library.entry_dir("..")
+            self.assertFalse((Path(tmp) / "safe").exists())
+
+
+if __name__ == "__main__":
+    unittest.main()
