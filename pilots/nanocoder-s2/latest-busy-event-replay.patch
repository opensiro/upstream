+#!/usr/bin/env node
+// First-party native smoke scenarios for opt-in backlog coalescing. No model or daemon.
+import assert from 'node:assert/strict';
+import {BackpressureDispatcher} from '../source/events/backpressure.ts';
+
+const subscription = id => ({id, kind:'schedule.cron',
+  target:{kind:'command',name:'report'},source:'manifest',ownerSkill:'report'});
+const event = id => ({kind:'schedule.cron',payload:{cron:id},at:1});
+function latch() {
+  let resolve, reject;
+  const promise=new Promise((res,rej)=>{resolve=res;reject=rej;});
+  return {promise,resolve,reject};
+}
+async function testDefaultDrop() {
+  const first=latch(), calls=[], dropped=[];
+  const dispatcher=new BackpressureDispatcher({async dispatch(_sub,e) {
+    calls.push(e.payload.cron);
+    if(calls.length===1) await first.promise;
+  }},{onDrop:(_sub,e)=>dropped.push(e.payload.cron)});
+  const a=dispatcher.dispatch(subscription('s'),event('a'));
+  await dispatcher.dispatch(subscription('s'),event('b'));
+  first.resolve(); await a;
+  assert.deepEqual(calls,['a']);
+  assert.deepEqual(dropped,['b']);
+  dispatcher.dispose();
+  console.log('PASS default busy-event drop preserved');
+}
+async function testOptInReplayLast() {
+  const first=latch(), calls=[], dropped=[];
+  let concurrent=0, peak=0;
+  const dispatcher=new BackpressureDispatcher({async dispatch(_sub,e) {
+    concurrent++;peak=Math.max(peak,concurrent);
+    calls.push(e.payload.cron);
+    if(calls.length===1) await first.promise;
+    concurrent--;
+  }},{replayLatestWhileBusy:true,onDrop:(_sub,e)=>dropped.push(e.payload.cron)});
+  const run=dispatcher.dispatch(subscription('s'),event('a'));
+  await dispatcher.dispatch(subscription('s'),event('b'));
+  await dispatcher.dispatch(subscription('s'),event('c'));
+  assert.deepEqual(calls,['a']);
+  first.resolve();await run;
+  assert.deepEqual(calls,['a','c']);
+  assert.deepEqual(dropped,['b']);
+  assert.equal(peak,1,'only one task at a time for same subscription');
+  dispatcher.dispose();
+  console.log('PASS one latest replay, older pending event coalesced');
+}
+async function testIndependentSubscriptions() {
+  const first=latch(), second=latch(), calls=[];
+  const dispatcher=new BackpressureDispatcher({async dispatch(_sub,e){
+    calls.push(e.payload.cron);
+    await (e.payload.cron==='a'?first.promise:second.promise);
+  }},{replayLatestWhileBusy:true});
+  const a=dispatcher.dispatch(subscription('first'),event('a'));
+  const b=dispatcher.dispatch(subscription('second'),event('b'));
+  assert.deepEqual(calls,['a','b']);
+  first.resolve();second.resolve();
+  await Promise.all([a,b]);dispatcher.dispose();
+  console.log('PASS different subscriptions remain independent');
+}
+async function testDispose() {
+  const first=latch(), calls=[];
+  const dispatcher=new BackpressureDispatcher({async dispatch(_sub,e) {
+    calls.push(e.payload.cron);
+    if(calls.length===1) await first.promise;
+  }},{replayLatestWhileBusy:true});
+  const run=dispatcher.dispatch(subscription('s'),event('a'));
+  await dispatcher.dispatch(subscription('s'),event('b'));
+  dispatcher.dispose();
+  first.resolve();await run;
+  assert.deepEqual(calls,['a']);
+  console.log('PASS shutdown cancels queued replay');
+}
+async function testFailureDoesNotReplay() {
+  const first=latch(), calls=[];
+  const dispatcher=new BackpressureDispatcher({async dispatch(_sub,e) {
+    calls.push(e.payload.cron);
+    if(e.payload.cron==='a') await first.promise;
+  }},{replayLatestWhileBusy:true});
+  const run=dispatcher.dispatch(subscription('s'),event('a'));
+  await dispatcher.dispatch(subscription('s'),event('b'));
+  first.reject(new Error('scripted execution failure'));
+  await assert.rejects(run,/scripted execution failure/);
+  assert.deepEqual(calls,['a'],'do not replay after a failed inner dispatch');
+  await dispatcher.dispatch(subscription('s'),event('c'));
+  assert.deepEqual(calls,['a','c'],'failure releases claim for subsequent events');
+  dispatcher.dispose();
+  console.log('PASS failure aborts queued replay and releases occupancy');
+}
+async function testDebouncedBusyReplay() {
+  const first=latch(), calls=[];
+  const dispatcher=new BackpressureDispatcher({async dispatch(_sub,e) {
+    calls.push(e.kind==='file.changed'?e.payload.file:e.payload.cron);
+    if(calls.length===1) await first.promise;
+  }},{replayLatestWhileBusy:true,debounceMs:10});
+  const run=dispatcher.dispatch(subscription('s'),event('cron'));
+  const sub={...subscription('s'),kind:'file.changed'};
+  dispatcher.dispatch(sub,{kind:'file.changed',payload:{file:'one',eventKind:'change'},at:1});
+  dispatcher.dispatch(sub,{kind:'file.changed',payload:{file:'two',eventKind:'change'},at:2});
+  await new Promise(resolve=>setTimeout(resolve,40));
+  first.resolve();await run;
+  assert.deepEqual(calls,['cron','two']);
+  dispatcher.dispose();
+  console.log('PASS debounced file event replays latest after active work');
+}
+await testDefaultDrop();
+await testOptInReplayLast();
+await testIndependentSubscriptions();
+await testDispose();
+await testFailureDoesNotReplay();
+await testDebouncedBusyReplay();
