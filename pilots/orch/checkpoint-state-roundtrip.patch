diff --git a/tests/test_checkpoint_roundtrip_unittest.py b/tests/test_checkpoint_roundtrip_unittest.py
new file mode 100644
index 0000000..05b2b40
--- /dev/null
+++ b/tests/test_checkpoint_roundtrip_unittest.py
@@ -0,0 +1,50 @@
+"""Pinned-source checkpoint invariants, exercised with scripts only."""
+
+from pathlib import Path
+from tempfile import TemporaryDirectory
+import sys
+import types
+import unittest
+
+# Load real state/persistence source under an isolated namespace: the normal
+# package __init__ imports optional OpenRouter integrations (requests).
+# Do not replace the actual "orchestrator" package in sys.modules.
+package = types.ModuleType("_orch_checkpoint_probe")
+package.__path__ = [str(Path(__file__).resolve().parents[1] / "orchestrator")]
+sys.modules["_orch_checkpoint_probe"] = package
+
+from _orch_checkpoint_probe.persistence import load_state, save_state
+from _orch_checkpoint_probe.state import WorkflowState
+
+
+class CheckpointRoundtripTests(unittest.TestCase):
+    def test_repository_context_survives_disk_resume(self):
+        with TemporaryDirectory() as temp:
+            path = Path(temp) / "checkpoint.json"
+            state = WorkflowState(task="fixed task", repository=temp)
+            state.repository_context = "repository facts used in this run"
+            save_state(path, state)
+            self.assertEqual(load_state(path).repository_context, state.repository_context)
+
+    def test_serialized_state_contains_repository_context(self):
+        state = WorkflowState(task="fixed", repository="/fixed")
+        state.repository_context = "pinned context"
+        self.assertEqual(state.to_dict()["repository_context"], "pinned context")
+
+    def test_stored_update_timestamp_survives_load(self):
+        state = WorkflowState(task="fixed", repository="/fixed")
+        payload = state.to_dict()
+        recovered = WorkflowState.from_dict(payload)
+        self.assertEqual(recovered.updated_at, payload["updated_at"])
+
+    def test_basic_state_roundtrip_without_provider(self):
+        with TemporaryDirectory() as temp:
+            path = Path(temp) / "checkpoint.json"
+            state = WorkflowState(task="fixed task", repository=temp)
+            save_state(path, state)
+            restored = load_state(path)
+            self.assertEqual((restored.run_id, restored.task), (state.run_id, state.task))
+
+
+if __name__ == "__main__":
+    unittest.main()
