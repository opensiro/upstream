+    def verify_integrity(self) -> IntegrityReport:
+        """Recheck stored payload/type hashes and parent links without modifying the DAG.
+
+        This detects accidental or partial changes to the hashed contents of a
+        saved trajectory. Hashes do not authenticate the writer, nor cover all
+        node metadata; a party able to rewrite every hash can forge a new DAG.
+        """
+        findings: list[IntegrityFinding] = []
+
+        if self.root_node_id not in self.nodes_by_id:
+            findings.append(IntegrityFinding(code="MISSING_ROOT", node_id=self.root_node_id))
+        if self.current_leaf_id not in self.nodes_by_id:
+            findings.append(IntegrityFinding(code="MISSING_LEAF", node_id=self.current_leaf_id))
+        if not nx.is_directed_acyclic_graph(self.graph):
+            findings.append(IntegrityFinding(code="CYCLE_DETECTED"))
+        for duplicate_id in self._duplicate_loaded_ids:
+            findings.append(IntegrityFinding(code="DUPLICATE_NODE_ID", node_id=duplicate_id))
+
+        for node_id, node in self.nodes_by_id.items():
+            if node_id != node.id:
+                findings.append(IntegrityFinding(code="NODE_ID_MISMATCH", node_id=node_id))
+            if node_id == self.root_node_id and (
+                node.parent_ids or node.node_type != NodeType.GOAL
+            ):
+                findings.append(IntegrityFinding(code="INVALID_ROOT", node_id=node_id))
+            if len(node.parent_ids) != len(set(node.parent_ids)):
+                findings.append(IntegrityFinding(code="DUPLICATE_PARENT", node_id=node_id))
+
+            parent_hashes = []
+            for parent_id in node.parent_ids:
+                parent = self.nodes_by_id.get(parent_id)
+                if parent is None:
+                    findings.append(IntegrityFinding(code="MISSING_PARENT", node_id=node_id))
+                else:
+                    parent_hashes.append(parent.content_hash)
+            # Incomplete parent sets are never accepted, even when a hash
+            # accidentally matches one computed without the missing parents.
+            if len(parent_hashes) != len(node.parent_ids):
+                continue
+            if node.content_hash != node.compute_hash(parent_hashes):
+                findings.append(IntegrityFinding(code="HASH_MISMATCH", node_id=node_id))
+
+        return IntegrityReport(
+            ok=not findings,
+            checked_nodes=len(self.nodes_by_id),
+            findings=findings,
+        )
+
