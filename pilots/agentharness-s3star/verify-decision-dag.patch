diff --git a/tests/unit/test_cli.py b/tests/unit/test_cli.py
index 130818a..345b7af 100644
--- a/tests/unit/test_cli.py
+++ b/tests/unit/test_cli.py
@@ -1,6 +1,9 @@
+import json
+
 from typer.testing import CliRunner
 
 from agent_harness.cli import app
+from agent_harness.graph.decision_dag import DecisionDAG, NodeType
 
 runner = CliRunner()
 
@@ -53,3 +56,29 @@ def test_cli_replay_help():
     res = runner.invoke(app, ["replay", "--help"])
     assert res.exit_code == 0
     assert "Replay previously recorded" in res.stdout
+
+
+def test_inspect_verify_detects_tampered_saved_dag(tmp_path):
+    storage = tmp_path / "runs"
+    storage.mkdir()
+    dag = DecisionDAG("audit-test", "inspect journal")
+    dag.create_child_node(NodeType.OBSERVATION, "response", {"result": "untampered"})
+    path = storage / "audit-test.json"
+    path.write_text(json.dumps(dag.to_dict()), encoding="utf-8")
+
+    intact = runner.invoke(app, ["inspect", "audit-test", "--storage", str(storage), "--verify"])
+    assert intact.exit_code == 0
+    assert "Integrity: PASS" in intact.stdout
+
+    changed = json.loads(path.read_text(encoding="utf-8"))
+    changed["nodes"][-1]["payload"]["result"] = "modified"
+    path.write_text(json.dumps(changed), encoding="utf-8")
+    broken = runner.invoke(app, ["inspect", "audit-test", "--storage", str(storage), "--verify"])
+    assert broken.exit_code != 0
+    assert "HASH_MISMATCH" in broken.stdout
+
+
+def test_inspect_verify_requires_explicit_run_id(tmp_path):
+    result = runner.invoke(app, ["inspect", "--storage", str(tmp_path), "--verify"])
+    assert result.exit_code == 2
+    assert "requires a specific run ID" in result.stdout
diff --git a/tests/unit/test_decision_dag.py b/tests/unit/test_decision_dag.py
index e840e43..da611de 100644
--- a/tests/unit/test_decision_dag.py
+++ b/tests/unit/test_decision_dag.py
@@ -52,3 +52,45 @@ def test_dag_serialization(sample_dag):
 
     cytoscape_elements = restored.to_cytoscape_elements()
     assert len(cytoscape_elements) >= 2
+
+
+def test_saved_dag_integrity_detects_modified_tool_observation(sample_dag):
+    observation = sample_dag.create_child_node(
+        NodeType.OBSERVATION, "tool output", {"stdout": "original response"}
+    )
+    saved = sample_dag.to_dict()
+    saved["nodes"][-1]["payload"]["stdout"] = "tampered response"
+
+    restored = DecisionDAG.from_dict(saved)
+    report = restored.verify_integrity()
+    assert report.ok is False
+    assert report.checked_nodes == 2
+    assert any(f.code == "HASH_MISMATCH" and f.node_id == observation.id for f in report.findings)
+
+
+def test_saved_dag_integrity_rejects_missing_parent_and_valid_roundtrip(sample_dag):
+    child = sample_dag.create_child_node(NodeType.TOOL_CALL, "call", {"args": [1, 2]})
+    intact = DecisionDAG.from_dict(sample_dag.to_dict())
+    assert intact.verify_integrity().ok is True
+
+    broken = sample_dag.to_dict()
+    broken["nodes"][-1]["parent_ids"] = ["does-not-exist"]
+    report = DecisionDAG.from_dict(broken).verify_integrity()
+    assert report.ok is False
+    assert any(f.code == "MISSING_PARENT" and f.node_id == child.id for f in report.findings)
+
+
+def test_saved_dag_integrity_detects_tampered_root_goal(sample_dag):
+    data = sample_dag.to_dict()
+    data["nodes"][0]["payload"]["goal"] = "substituted goal"
+    report = DecisionDAG.from_dict(data).verify_integrity()
+    assert report.ok is False
+    assert any(f.code == "HASH_MISMATCH" for f in report.findings)
+
+
+def test_saved_dag_integrity_detects_duplicate_serialized_node_ids(sample_dag):
+    data = sample_dag.to_dict()
+    data["nodes"].append(data["nodes"][0].copy())
+    report = DecisionDAG.from_dict(data).verify_integrity()
+    assert report.ok is False
+    assert any(f.code == "DUPLICATE_NODE_ID" for f in report.findings)
