diff --git a/test_native_workspace_overlap_unittest.py b/test_native_workspace_overlap_unittest.py
new file mode 100644
index 0000000..9a36989
--- /dev/null
+++ b/test_native_workspace_overlap_unittest.py
@@ -0,0 +1,85 @@
+"""Deterministic tests for the real workspace/engine isolation validator.
+
+Load its class body from the first-party source AST without importing the
+unrelated runtime resolver (which initializes optional agent dependencies).
+"""
+
+import ast
+import importlib.util
+import os
+import sys
+import tempfile
+import unittest
+from datetime import datetime, timezone
+from pathlib import Path
+
+
+BASE = Path(__file__).parent / "runtime/workspace"
+spec = importlib.util.spec_from_file_location("oniroute_workspace_models", BASE / "models.py")
+models = importlib.util.module_from_spec(spec)
+sys.modules[spec.name] = models
+spec.loader.exec_module(models)
+
+path = BASE / "validation.py"
+source = ast.parse(path.read_text(encoding="utf-8"), filename=str(path))
+validator_class = next(node for node in source.body if isinstance(node, ast.ClassDef) and node.name == "WorkspaceValidator")
+scope = {
+    "datetime": datetime,
+    "timezone": timezone,
+    "os": os,
+    "Path": Path,
+    "ProjectMetadata": models.ProjectMetadata,
+    "ValidationIssue": models.ValidationIssue,
+    "ValidationState": models.ValidationState,
+}
+exec(compile(ast.fix_missing_locations(ast.Module(body=[validator_class], type_ignores=[])), str(path), "exec"), scope)
+WorkspaceValidator = scope["WorkspaceValidator"]
+
+
+class NativeWorkspaceOverlapTests(unittest.TestCase):
+    def validate(self, workspace: Path, engine: Path):
+        return WorkspaceValidator().validate(workspace, engine)
+
+    def test_disjoint_roots_are_valid(self):
+        with tempfile.TemporaryDirectory() as temp:
+            base = Path(temp)
+            ws, eng = base / "ws", base / "engine"
+            ws.mkdir()
+            eng.mkdir()
+            self.assertTrue(self.validate(ws, eng).valid)
+
+    def test_equal_roots_are_rejected(self):
+        with tempfile.TemporaryDirectory() as temp:
+            self.assertFalse(self.validate(Path(temp), Path(temp)).valid)
+
+    def test_workspace_nested_inside_engine_is_rejected(self):
+        with tempfile.TemporaryDirectory() as temp:
+            eng = Path(temp) / "engine"
+            ws = eng / "user-workspace"
+            ws.mkdir(parents=True)
+            state = self.validate(ws, eng)
+            self.assertFalse(state.valid)
+            self.assertIn("ENGINE_WORKSPACE_COLLISION", [x.code for x in state.issues])
+
+    def test_engine_nested_inside_workspace_is_rejected(self):
+        with tempfile.TemporaryDirectory() as temp:
+            ws = Path(temp) / "ws"
+            eng = ws / "engine"
+            eng.mkdir(parents=True)
+            state = self.validate(ws, eng)
+            self.assertFalse(state.valid)
+            self.assertIn("ENGINE_WORKSPACE_COLLISION", [x.code for x in state.issues])
+
+    def test_symlink_alias_to_overlapping_workspace_is_rejected(self):
+        with tempfile.TemporaryDirectory() as temp:
+            root = Path(temp)
+            eng = root / "engine"
+            ws = eng / "subdir"
+            ws.mkdir(parents=True)
+            alias = root / "workspace-alias"
+            alias.symlink_to(ws, target_is_directory=True)
+            self.assertFalse(self.validate(alias, eng).valid)
+
+
+if __name__ == "__main__":
+    unittest.main()
