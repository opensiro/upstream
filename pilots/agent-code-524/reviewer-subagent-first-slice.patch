+/// Display only a bounded, untrusted *report* in the parent transcript.
+fn format_review_report(id: &str, output: &agent_code_lib::review::ReviewOutput) -> String {
+    fn short(s: &str, max: usize) -> String {
+        s.replace(['\n', '\r'], " ").chars().take(max).collect()
+    }
+    let mut out = format!(
+        "Independent reviewer task {id} (unverified model findings): {}. {} finding(s).",
+        output.overall_correctness,
+        output.findings.len()
+    );
+    for finding in output.findings.iter().take(20) {
+        let loc = &finding.code_location;
+        out.push_str(&format!(
+            "\n[P{}] {}:{}-{} {} — {}",
+            finding.priority,
+            short(&loc.absolute_file_path, 160),
+            loc.line_range.start,
+            loc.line_range.end,
+            short(&finding.title, 160),
+            short(&finding.body, 400),
+        ));
+    }
+    if output.findings.len() > 20 {
+        out.push_str("\nAdditional findings remain in the /tasks output.");
+    }
+    out
+}
