+use serde::Deserialize;
+
+/// Typed reviewer output. Claims are untrusted until independently verified.
+#[derive(Debug, Clone, PartialEq, Deserialize)]
+pub struct ReviewOutput {
+    pub findings: Vec<ReviewFinding>,
+    pub overall_correctness: String,
+    pub overall_explanation: String,
+    pub overall_confidence_score: f64,
+}
+
+#[derive(Debug, Clone, PartialEq, Deserialize)]
+pub struct ReviewFinding {
+    pub title: String,
+    pub body: String,
+    pub confidence_score: f64,
+    pub priority: u8,
+    pub code_location: ReviewLocation,
+}
+
+#[derive(Debug, Clone, PartialEq, Deserialize)]
+pub struct ReviewLocation {
+    pub absolute_file_path: String,
+    pub line_range: ReviewLineRange,
+}
+
+#[derive(Debug, Clone, PartialEq, Deserialize)]
+pub struct ReviewLineRange {
+    pub start: u64,
+    pub end: u64,
+}
+
+pub const OUTPUT_INSTRUCTIONS: &str = r#"Return only one JSON object, no commentary:
+{"findings":[{"title":"[P1] short actionable defect","body":"Impact and conditions",
+"confidence_score":0.9,"priority":1,
+"code_location":{"absolute_file_path":"/repo/file.rs",
+"line_range":{"start":10,"end":12}}}],
+"overall_correctness":"patch is incorrect",
+"overall_explanation":"Brief explanation",
+"overall_confidence_score":0.9}
+When no proven defect exists use findings: [] and "patch is correct".
+Priority is an integer P0-P3, confidence is between 0 and 1.
+Include no extra prose."#;
+
+pub fn parse_review_output(text: &str) -> Result<ReviewOutput, String> {
+    let report: ReviewOutput =
+        serde_json::from_str(text.trim()).map_err(|e| format!("Invalid review JSON: {e}"))?;
+    if !matches!(
+        report.overall_correctness.as_str(),
+        "patch is correct" | "patch is incorrect"
+    ) {
+        return Err("Invalid review verdict".into());
+    }
+    if !(0.0..=1.0).contains(&report.overall_confidence_score) {
+        return Err("Invalid overall confidence".into());
+    }
+    for f in &report.findings {
+        if f.priority > 3 || !(0.0..=1.0).contains(&f.confidence_score) {
+            return Err("Invalid review finding priority/confidence".into());
+        }
+        if !f.code_location.absolute_file_path.starts_with('/')
+            || f.code_location.line_range.start == 0
+            || f.code_location.line_range.end < f.code_location.line_range.start
+        {
+            return Err("Invalid review finding location".into());
+        }
+    }
+    Ok(report)
+}
