+    #[test]
+    fn review_subagent_is_a_fresh_process_with_a_read_only_tool_boundary() {
+        let registry = AgentRegistry::with_defaults();
+        let review = registry.get("review").expect("built-in review agent");
+        let cmd = build_subagent_command(
+            "Inspect commit aabbcc",
+            std::path::Path::new("/tmp"),
+            "sid-review",
+            None,
+            None,
+            Some(review),
+            &SubagentEndpoint::default(),
+        );
+        let std_cmd = cmd.as_std();
+        let args: Vec<String> = std_cmd
+            .get_args()
+            .map(|a| a.to_string_lossy().into_owned())
+            .collect();
+        let prompt_pos = args.iter().position(|a| a == "--prompt").unwrap();
+        let prompt = &args[prompt_pos + 1];
+        assert!(prompt.contains("Inspect commit aabbcc"));
+        assert!(prompt.contains("introduced by this change"));
+        assert!(!prompt.contains("PRIVATE_PARENT_TRANSCRIPT_SENTINEL"));
+        assert!(
+            args.windows(2)
+                .any(|w| w[0] == "--permission-mode" && w[1] == "plan")
+        );
+        assert!(args.iter().any(|x| x == "--permissions-overlay"));
+        assert!(
+            args.windows(2)
+                .any(|w| w[0] == "--max-turns" && w[1] == "20")
+        );
+        assert!(
+            std_cmd
+                .get_envs()
+                .any(|(key, val)| key == "AGENT_CODE_SUBAGENT_TYPE"
+                    && val == Some(std::ffi::OsStr::new("review")))
+        );
+    }
