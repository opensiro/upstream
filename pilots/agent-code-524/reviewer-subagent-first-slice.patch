+/// Parse *completed* child JSONL events, extracting only the last
+/// assistant turn's text stream. Tool outputs and reasoning are excluded;
+/// a missing session envelope, truncated stdout or non-zero child exit
+/// never becomes a successful review.
+pub fn parse_review_jsonl(text: &str) -> Result<ReviewOutput, String> {
+    use std::collections::BTreeMap;
+    let mut saw_start = false;
+    let mut saw_end = false;
+    let mut final_turn: Option<u64> = None;
+    let mut text_by_turn = BTreeMap::<u64, String>::new();
+    for line in text.lines() {
+        let event: serde_json::Value =
+            serde_json::from_str(line).map_err(|e| format!("Invalid reviewer JSONL event: {e}"))?;
+        match event.get("type").and_then(serde_json::Value::as_str) {
+            Some("session_start") if !saw_start && !saw_end => saw_start = true,
+            Some("text_delta") if saw_start && !saw_end => {
+                let turn = event
+                    .get("turn")
+                    .and_then(serde_json::Value::as_u64)
+                    .ok_or("Reviewer text event has no numeric turn")?;
+                let delta = event
+                    .get("content")
+                    .and_then(serde_json::Value::as_str)
+                    .ok_or("Reviewer text event has no content")?;
+                text_by_turn.entry(turn).or_default().push_str(delta);
+            }
+            Some("turn_complete") if saw_start && !saw_end => {
+                let turn = event
+                    .get("turn")
+                    .and_then(serde_json::Value::as_u64)
+                    .ok_or("Reviewer turn completion has no turn")?;
+                final_turn = Some(turn);
+            }
+            Some("session_end") if saw_start && !saw_end => {
+                if event.get("exit_code").and_then(serde_json::Value::as_u64) != Some(0) {
+                    return Err("Reviewer child did not exit successfully".into());
+                }
+                saw_end = true;
+            }
+            Some(
+                "thinking" | "tool_call" | "tool_result" | "warning" | "turn_start" | "compact",
+            ) if saw_start && !saw_end => {}
+            Some("error" | "permission_denied") if saw_start && !saw_end => {
+                return Err("Reviewer child reported an error or denied permission".into());
+            }
+            _ => return Err("Unexpected or out-of-order reviewer JSONL event".into()),
+        }
+    }
+    if !saw_end {
+        return Err("Incomplete reviewer JSONL session".into());
+    }
+    let turn = final_turn.ok_or("Reviewer produced no completed turn")?;
+    let answer = text_by_turn
+        .get(&turn)
+        .ok_or("Reviewer completed without a final text answer")?;
+    parse_review_output(answer)
+}
