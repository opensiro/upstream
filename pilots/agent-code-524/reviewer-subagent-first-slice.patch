+        let x = parse_review_output(r#"{"findings":[{"title":"[P1] race","body":"Lost update","confidence_score":0.9,"priority":1,"code_location":{"absolute_file_path":"/repo/src/lib.rs","line_range":{"start":10,"end":12}}}],"overall_correctness":"patch is incorrect","overall_explanation":"Race","overall_confidence_score":0.9}"#).unwrap();
+        assert_eq!(x.findings[0].priority, 1);
+    }
+    #[test]
+    fn jsonl_review_reads_final_assistant_text_not_tool_output() {
+        let report = r#"{"findings":[],"overall_correctness":"patch is correct","overall_explanation":"No defect.","overall_confidence_score":0.8}"#;
+        let first = &report[..50];
+        let second = &report[50..];
+        let lines = format!(
+            "{{\"type\":\"session_start\"}}\n{{\"type\":\"thinking\",\"turn\":1,\"content\":\"private reasoning\"}}\n{{\"type\":\"tool_result\",\"turn\":1,\"output\":\"untrusted tool data\"}}\n{{\"type\":\"text_delta\",\"turn\":1,\"content\":{}}}\n{{\"type\":\"text_delta\",\"turn\":1,\"content\":{}}}\n{{\"type\":\"turn_complete\",\"turn\":1}}\n{{\"type\":\"session_end\",\"exit_code\":0}}\n",
+            serde_json::to_string(first).unwrap(),
+            serde_json::to_string(second).unwrap(),
+        );
+        let result = parse_review_jsonl(&lines).unwrap();
+        assert_eq!(result.overall_correctness, "patch is correct");
+    }
+
+    #[test]
+    fn jsonl_review_rejects_partial_failed_and_unstructured_child() {
+        let good = "{\"type\":\"session_start\"}\n{\"type\":\"text_delta\",\"turn\":1,\"content\":\"Hello\"}\n{\"type\":\"turn_complete\",\"turn\":1}\n";
+        assert!(parse_review_jsonl(good).is_err());
+        assert!(
+            parse_review_jsonl(
+                &(good.to_string() + "{\"type\":\"session_end\",\"exit_code\":4}\n")
+            )
+            .is_err()
+        );
+        assert!(
+            parse_review_jsonl(
+                &(good.to_string() + "{\"type\":\"session_end\",\"exit_code\":0}\n")
+            )
+            .is_err()
+        );
+        assert!(parse_review_jsonl("garbage\n").is_err());
+    }
+
+    #[test]
+    fn freeform_review_and_invalid_locations_are_rejected() {
+        assert!(parse_review_output("Looks fine").is_err());
+        assert!(parse_review_output(r#"{"findings":[{"title":"Bad","body":"x","confidence_score":0.9,"priority":4,"code_location":{"absolute_file_path":"/repo/x","line_range":{"start":0,"end":1}}}],"overall_correctness":"patch is incorrect","overall_explanation":"x","overall_confidence_score":0.9}"#).is_err());
+    }
+}
