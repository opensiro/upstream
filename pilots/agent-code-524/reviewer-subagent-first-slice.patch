+pub fn parse_review_output(text: &str) -> Result<ReviewOutput, String> {
+    let report: ReviewOutput =
+        serde_json::from_str(text.trim()).map_err(|e| format!("Invalid review JSON: {e}"))?;
+    if !matches!(
+        report.overall_correctness.as_str(),
+        "patch is correct" | "patch is incorrect"
+    ) {
+        return Err("Invalid review verdict".into());
+    }
+    if !(0.0..=1.0).contains(&report.overall_confidence_score) {
+        return Err("Invalid overall confidence".into());
+    }
+    for f in &report.findings {
+        if f.priority > 3 || !(0.0..=1.0).contains(&f.confidence_score) {
+            return Err("Invalid review finding priority/confidence".into());
+        }
+        if !f.code_location.absolute_file_path.starts_with('/')
+            || f.code_location.line_range.start == 0
+            || f.code_location.line_range.end < f.code_location.line_range.start
+        {
+            return Err("Invalid review finding location".into());
+        }
+    }
+    Ok(report)
+}
