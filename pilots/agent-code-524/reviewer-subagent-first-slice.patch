+    #[test]
+    fn builtin_review_subagent_is_constrained_and_has_a_rubric() {
+        let registry = AgentRegistry::with_defaults();
+        let reviewer = registry.get("review").expect("registered reviewer");
+
+        assert!(reviewer.read_only);
+        assert_eq!(reviewer.max_turns, Some(20));
+        let perms = effective_permissions(reviewer).expect("reviewer tool boundary");
+        assert_eq!(perms.default_mode, PermissionMode::Plan);
+        for required in ["FileRead", "Grep", "Glob", "Bash"] {
+            assert!(perms.allowed_tools.iter().any(|name| name == required));
+        }
+        for forbidden in [
+            "WebFetch",
+            "WebSearch",
+            "Agent",
+            "Task",
+            "FileWrite",
+            "FileEdit",
+            "MultiEdit",
+            "NotebookEdit",
+        ] {
+            assert!(
+                !perms.allowed_tools.iter().any(|name| name == forbidden),
+                "review unexpectedly allows {forbidden}"
+            );
+        }
+        let prompt = compose_agent_prompt(reviewer, "Review commit abc");
+        for required in [
+            "introduced by this change",
+            "AGENTS.md",
+            "[P0]",
+            "no findings",
+            "Review commit abc",
+        ] {
+            assert!(
+                prompt.contains(required),
+                "review prompt missing {required}"
+            );
+        }
+    }
