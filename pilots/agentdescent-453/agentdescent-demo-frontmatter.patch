+def test_demo_generated_skill_has_valid_host_metadata(tmp_path):
+    """Demo output must have valid metadata required by Agent Skill hosts."""
+    from agentdescent.filetree import load_tree
+    from agentdescent.skillspec import parse_skill_frontmatter, validate_skill_tree
+
+    demo.build(str(tmp_path))
+    skill_dir = tmp_path / demo.DEMO_SKILL
+    tree = load_tree(str(skill_dir))
+    assert validate_skill_tree(tree, root_name=demo.DEMO_SKILL) == []
+    frontmatter = parse_skill_frontmatter(tree["SKILL.md"])
+    assert frontmatter is not None
+    assert frontmatter["name"] == demo.DEMO_SKILL
+    assert "data.csv" in frontmatter["description"]
+    # A generated demo spec must not silently disable the SKILL.md validator.
+    plan = subprocess.run(
+        [sys.executable, "-m", "agentdescent.cli", "plan", str(tmp_path / "spec.json")],
+        capture_output=True, text=True, cwd=ROOT, timeout=30,
+    )
+    assert plan.returncode == 0, plan.stdout + plan.stderr
+    assert "structural gate is off" not in plan.stdout + plan.stderr
+
+
