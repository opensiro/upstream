 /// A run cancelled while the call waited for the file is `Cancelled`: the
 /// call must not act.
 ///
 /// [`PathSandbox::check`]: crate::tools::PathSandbox::check
+#[derive(Hash, Eq, PartialEq)]
+enum FileLockKey {
+    ResolvedPath(PathBuf),
+    #[cfg(unix)]
+    Inode { device: u64, inode: u64 },
+}
+
+/// On Unix, hard links have distinct resolved paths but address one file.
+/// Use its stable identity for existing regular files; absent files keep
+/// their resolved path so competing creates still serialize.
+fn file_lock_key(path: &Path) -> FileLockKey {
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::MetadataExt;
+        if let Ok(metadata) = std::fs::metadata(path) {
+            if metadata.is_file() {
+                return FileLockKey::Inode {
+                    device: metadata.dev(),
+                    inode: metadata.ino(),
+                };
+            }
+        }
+    }
+    FileLockKey::ResolvedPath(path.to_path_buf())
+}
+
