index 0000000..b10282b
--- /dev/null
+++ b/packages/server/test/tool-gateway-ownership.test.ts
@@ -0,0 +1,155 @@
+/**
+ * HarnessDesk #1772: a duplicate host must not take or unlink a live
+ * ToolGateway's socket, and a crashed owner's socket can be reclaimed.
+ */
+import assert from 'node:assert/strict'
+import { spawn } from 'node:child_process'
+import { once } from 'node:events'
+import { existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs'
+import { connect } from 'node:net'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { test } from 'node:test'
+
+import type { ToolResult } from '@harnessdesk/protocol'
+import { ToolGateway } from '../src/tool-gateway.js'
+
+const socketHome = (): string =>
+  tmpdir().length < 104 - '/hd-ownership-XXXXXX/tools.sock'.length ? tmpdir() : '/tmp'
+
+const gatewayFor = (path: string, who: string): ToolGateway =>
+  new ToolGateway(path, {
+    listTools: () => [],
+    invokeByName: async (): Promise<ToolResult> => ({ ok: true, content: [] }),
+    instructions: () => who,
+  })
+
+const whoAnswers = (path: string): Promise<string> =>
+  new Promise((resolve, reject) => {
+    const socket = connect(path)
+    let received = ''
+    const timeout = setTimeout(() => { socket.destroy(); reject(new Error('gateway timed out')) }, 3000)
+    timeout.unref()
+    socket.once('error', (err) => { clearTimeout(timeout); reject(err) })
+    socket.on('connect', () => socket.write('{"id":1,"method":"server/info","params":{}}\n'))
+    socket.on('data', (bytes) => {
+      received += bytes.toString()
+      if (!received.includes('\n')) return
+      clearTimeout(timeout)
+      socket.end()
+      resolve((JSON.parse(received.split('\n')[0]!) as { result: { instructions: string } }).result.instructions)
+    })
+  })
+
+test('duplicate gateway cannot steal or unlink the live first host tool socket', async () => {
+  const home = mkdtempSync(join(socketHome(), 'hd-ownership-'))
+  const socket = join(home, 'tools.sock')
+  const first = gatewayFor(socket, 'first')
+  const duplicate = gatewayFor(socket, 'duplicate')
+  try {
+    first.start()
+    assert.equal(await whoAnswers(socket), 'first')
+    assert.throws(() => duplicate.start(), /already owned/)
+    assert.equal(await whoAnswers(socket), 'first')
+    await duplicate.stop()
+    assert.equal(await whoAnswers(socket), 'first')
+    assert.throws(() => first.start(), /already started/)
+  } finally {
+    await duplicate.stop()
+    await first.stop()
+    assert.equal(existsSync(socket + '.owner'), false)
+    rmSync(home, { recursive: true, force: true })
+  }
+})
+
+test('stale owner lock and stale socket are reclaimed after owner PID exits', async () => {
+  const home = mkdtempSync(join(socketHome(), 'hd-stale-'))
+  const socket = join(home, 'tools.sock')
+  const gateway = gatewayFor(socket, 'restarted')
+  try {
+    writeFileSync(socket + '.owner', JSON.stringify({ pid: 2147483000, nonce: 'terminated' }))
+    writeFileSync(socket, 'stale after crashed host')
+    gateway.start()
+    assert.equal(await whoAnswers(socket), 'restarted')
+    const owner = JSON.parse(readFileSync(socket + '.owner', 'utf8')) as { pid: number; nonce: string }
+    assert.equal(owner.pid, process.pid)
+    assert.notEqual(owner.nonce, 'terminated')
+    assert.equal(existsSync(socket + '.owner.recovery'), false)
+  } finally {
+    await gateway.stop()
+    rmSync(home, { recursive: true, force: true })
+  }
+})
+
+test('a killed separate host leaves a reclaimable socket without stealing a live host', async () => {
+  const home = mkdtempSync(join(socketHome(), 'hd-process-'))
+  const socket = join(home, 'tools.sock')
+  const gatewayURL = new URL('../src/tool-gateway.js', import.meta.url).href
+  const childScript = `
+    import { ToolGateway } from ${JSON.stringify(gatewayURL)};
+    const gateway = new ToolGateway(process.argv[1], {
+      listTools: () => [],
+      invokeByName: async () => ({ ok: true, content: [] }),
+      instructions: () => 'child-owner',
+    });
+    gateway.start();
+    setInterval(() => {}, 1000);
+  `
+  const child = spawn(process.execPath, ['--input-type=module', '-e', childScript, socket],
+    { stdio: 'ignore' })
+  const recovery = gatewayFor(socket, 'recovered')
+  try {
+    const deadline = Date.now() + 5000
+    for (;;) {
+      try {
+        assert.equal(await whoAnswers(socket), 'child-owner')
+        break
+      } catch (error) {
+        if (Date.now() >= deadline) throw error
+        await new Promise((resolve) => setTimeout(resolve, 50))
+      }
+    }
+    assert.throws(() => recovery.start(), /already owned/)
+    assert.equal(await whoAnswers(socket), 'child-owner')
+    child.kill('SIGKILL')
+    await once(child, 'exit')
+    recovery.start()
+    assert.equal(await whoAnswers(socket), 'recovered')
+    await recovery.stop()
+    assert.equal(existsSync(socket + '.owner'), false)
+  } finally {
+    child.kill('SIGKILL')
+    await recovery.stop()
+    rmSync(home, { recursive: true, force: true })
+  }
+})
+
+test('another host refuses an in-progress stale recovery instead of removing its socket', async () => {
+  const home = mkdtempSync(join(socketHome(), 'hd-recovery-'))
+  const socket = join(home, 'tools.sock')
+  const gateway = gatewayFor(socket, 'blocked')
+  try {
+    writeFileSync(socket, 'protected during recovery')
+    mkdirSync(socket + '.owner.recovery')
+    assert.throws(() => gateway.start(), /recovery is already in progress/)
+    assert.equal(readFileSync(socket, 'utf8'), 'protected during recovery')
+    await gateway.stop()
+  } finally {
+    rmSync(home, { recursive: true, force: true })
+  }
+})
+
+test('unknown ownerless socket is not removed by a second gateway', async () => {
+  const home = mkdtempSync(join(socketHome(), 'hd-unknown-'))
+  const socket = join(home, 'tools.sock')
+  writeFileSync(socket, 'unknown legacy path; may be in use')
+  const gateway = gatewayFor(socket, 'refused')
+  try {
+    assert.throws(() => gateway.start(), /no verified dead owner/)
+    await gateway.stop()
+    assert.equal(readFileSync(socket, 'utf8'), 'unknown legacy path; may be in use')
+    assert.equal(existsSync(socket + '.owner'), false)
+  } finally {
+    rmSync(home, { recursive: true, force: true })
+  }
+})
