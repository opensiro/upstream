+@pytest.mark.parametrize("rollback", [False, True])
+def test_optimization_rollback_preserves_last_successful_graph(tmp_path, monkeypatch, rollback):
+    """A structurally valid edited graph can still fail when actually executed."""
+    orchestrator = make_orchestrator(tmp_path)
+
+    def fake_optimizer(_optimizer, *, prompt: str, repo_dir: Path, runtime_dir: Path, env: dict[str, str]):
+        pipeline_path = repo_dir / "pipeline.py"
+        source = pipeline_path.read_text(encoding="utf-8")
+        assert "'id': 'plan'" in source
+        pipeline_path.write_text(source.replace("'id': 'plan'", "'id': 'fail_always'"), encoding="utf-8")
+        return CommandExecution(command="optimizer", exit_code=0, stdout="valid but failing graph", stderr="")
+
+    monkeypatch.setattr("agentflow.orchestrator._run_optimizer", fake_optimizer)
+    config = {
+        "name": "graph-opt-rollback",
+        "working_dir": str(tmp_path),
+        "optimizer": "codex",
+        "n_run": 2,
+        "nodes": [{"id": "plan", "agent": "codex", "prompt": "stable result"}],
+    }
+    if rollback:
+        config["rollback_on_failed_optimization"] = True
+    pipeline = PipelineSpec.model_validate(config)
+
+    submitted = asyncio.run(orchestrator.submit(pipeline))
+    final = asyncio.run(orchestrator.wait(submitted.id, timeout=5))
+    child_run_ids = final.optimization_session["child_run_ids"]
+    assert len(child_run_ids) == 2
+    assert orchestrator.store.get_run(child_run_ids[0]).status == RunStatus.COMPLETED
+    assert orchestrator.store.get_run(child_run_ids[1]).status == RunStatus.FAILED
+
+    if rollback:
+        assert final.status == RunStatus.COMPLETED
+        assert list(final.nodes) == ["plan"]
+        assert final.pipeline.nodes[0].id == "plan"
+        assert final.optimization_session["selected_child_run_id"] == child_run_ids[0]
+        assert final.optimization_session["rolled_back_child_run_ids"] == [child_run_ids[1]]
+    else:
+        assert final.status == RunStatus.FAILED
+        assert list(final.nodes) == ["fail_always"]
+        assert final.pipeline.nodes[0].id == "fail_always"
+
+
+def test_optimization_rollback_retries_safe_graph_on_remaining_rounds(tmp_path, monkeypatch):
+    orchestrator = make_orchestrator(tmp_path)
+    optimizer_calls: list[str] = []
+
+    def failing_optimizer(_optimizer, *, prompt: str, repo_dir: Path, runtime_dir: Path, env: dict[str, str]):
+        path = repo_dir / "pipeline.py"
+        source = path.read_text(encoding="utf-8")
+        optimizer_calls.append(source)
+        assert "'id': 'plan'" in source
+        # An optimizer cannot remove the owner-set recovery policy.
+        path.write_text(
+            source.replace("'id': 'plan'", "'id': 'fail_always'").replace(
+                "'rollback_on_failed_optimization': True",
+                "'rollback_on_failed_optimization': False",
+            ),
+            encoding="utf-8",
+        )
+        return CommandExecution(command="optimizer", exit_code=0, stdout="bad but valid edit", stderr="")
+
+    monkeypatch.setattr("agentflow.orchestrator._run_optimizer", failing_optimizer)
+    pipeline = PipelineSpec.model_validate(
+        {
+            "name": "three-round-fallback",
+            "working_dir": str(tmp_path),
+            "optimizer": "codex",
+            "n_run": 3,
+            "rollback_on_failed_optimization": True,
+            "nodes": [{"id": "plan", "agent": "codex", "prompt": "original"}],
+        }
+    )
+    submitted = asyncio.run(orchestrator.submit(pipeline))
+    completed = asyncio.run(orchestrator.wait(submitted.id, timeout=5))
+    assert completed.status == RunStatus.COMPLETED
+    ids = completed.optimization_session["child_run_ids"]
+    assert [orchestrator.store.get_run(id_).status for id_ in ids] == [
+        RunStatus.COMPLETED,
+        RunStatus.FAILED,
+        RunStatus.COMPLETED,
+    ]
+    assert completed.optimization_session["rolled_back_child_run_ids"] == [ids[1]]
+    assert completed.optimization_session["selected_child_run_id"] == ids[2]
+    assert completed.pipeline.rollback_on_failed_optimization is True
+    assert completed.nodes["plan"].output == "original"
+    assert len(optimizer_calls) == 1
+
+
