+// One registry (shared by the root agent and delegated child runs) owns one
+// editFile instance. Keep locks only while edits are in flight; different
+// paths remain independent and do not accumulate locks for the daemon's life.
+type editFileGuard struct {
+	mu    sync.Mutex
+	users int
 }
 
 func newEditFile(workspace string) *editFile { return &editFile{workspace: workspace} }
 
+func (t *editFile) lockPath(path string) func() {
+	// resolvePath already checked containment. Coalesce in-workspace symlink
+	// aliases so two spellings of the same existing file share one lock.
+	path = resolveExistingAncestor(path)
+	t.guardsMu.Lock()
+	if t.guards == nil {
+		t.guards = make(map[string]*editFileGuard)
+	}
+	guard := t.guards[path]
+	if guard == nil {
+		guard = &editFileGuard{}
+		t.guards[path] = guard
+	}
+	guard.users++
+	t.guardsMu.Unlock()
+
+	guard.mu.Lock()
+	return func() {
+		guard.mu.Unlock()
+		t.guardsMu.Lock()
+		guard.users--
+		if guard.users == 0 {
+			delete(t.guards, path)
+		}
+		t.guardsMu.Unlock()
+	}
+}
+
 func (t *editFile) Name() string { return "edit_file" }
 func (t *editFile) Description() string {
 	return "Replace an exact substring in a file with another. Fails if old_string isn't found, or is found more than once and replace_all wasn't set — include enough surrounding context in old_string to make it unique."
