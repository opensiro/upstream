@@ -0,0 +1,151 @@
+package tools
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+)
+
+// TestS2SameFileEditReplay is a frozen 50-trial tool-level replay. It is not
+// a provider-backed test of live model-selected delegate_task goals.
+func TestS2SameFileEditReplay(t *testing.T) {
+	const trials = 50
+	const padding = 1 << 20
+	var preserved, lost, errors, silentLost int
+	for trial := 0; trial < trials; trial++ {
+		workspace := t.TempDir()
+		path := filepath.Join(workspace, "shared.txt")
+		initial := "ALPHA=old\n" + strings.Repeat("x", padding) + "\nBETA=old\n"
+		if err := os.WriteFile(path, []byte(initial), 0o644); err != nil {
+			t.Fatal(err)
+		}
+		tool := newEditFile(workspace)
+		edits := []editFileArgs{
+			{Path: "shared.txt", OldString: "ALPHA=old", NewString: "ALPHA=new"},
+			{Path: "shared.txt", OldString: "BETA=old", NewString: "BETA=new"},
+		}
+		start := make(chan struct{})
+		var wg sync.WaitGroup
+		results := make([]string, len(edits))
+		for i := range edits {
+			wg.Add(1)
+			go func(i int) {
+				defer wg.Done()
+				<-start
+				raw, _ := json.Marshal(edits[i])
+				out, err := tool.Execute(context.Background(), raw)
+				if err != nil {
+					results[i] = "error: " + err.Error()
+				} else {
+					results[i] = out
+				}
+			}(i)
+		}
+		close(start)
+		wg.Wait()
+		end, err := os.ReadFile(path)
+		if err != nil {
+			t.Fatal(err)
+		}
+		both := strings.Contains(string(end), "ALPHA=new") && strings.Contains(string(end), "BETA=new")
+		if both {
+			preserved++
+		} else {
+			lost++
+		}
+		for _, res := range results {
+			if strings.HasPrefix(res, "error:") {
+				errors++
+			}
+		}
+		if !both && !strings.HasPrefix(results[0], "error:") && !strings.HasPrefix(results[1], "error:") {
+			silentLost++
+		}
+	}
+	t.Logf("S2_REPLAY same_path trials=%d preserved=%d lost=%d silent_lost=%d tool_errors=%d", trials, preserved, lost, silentLost, errors)
+	if lost != 0 {
+		t.Errorf("same-path independent edits failed preservation in %d/%d trials (%d silent)", lost, trials, silentLost)
+	}
+}
+
+func TestS2CompetingSameMarker(t *testing.T) {
+	const trials = 50
+	var doubleSuccess int
+	for trial := 0; trial < trials; trial++ {
+		workspace := t.TempDir()
+		path := filepath.Join(workspace, "shared.txt")
+		if err := os.WriteFile(path, []byte("KEY=old\n"+strings.Repeat("x", 1<<20)), 0o644); err != nil {
+			t.Fatal(err)
+		}
+		tool := newEditFile(workspace)
+		edits := []editFileArgs{
+			{Path: "shared.txt", OldString: "KEY=old", NewString: "KEY=one"},
+			{Path: "shared.txt", OldString: "KEY=old", NewString: "KEY=two"},
+		}
+		start := make(chan struct{})
+		var wg sync.WaitGroup
+		results := make([]string, len(edits))
+		for i := range edits {
+			wg.Add(1)
+			go func(i int) {
+				defer wg.Done()
+				<-start
+				raw, _ := json.Marshal(edits[i])
+				results[i], _ = tool.Execute(context.Background(), raw)
+			}(i)
+		}
+		close(start)
+		wg.Wait()
+		if strings.HasPrefix(results[0], "replaced ") && strings.HasPrefix(results[1], "replaced ") {
+			doubleSuccess++
+		}
+	}
+	t.Logf("S2_REPLAY same_marker trials=%d double_success=%d", trials, doubleSuccess)
+	if doubleSuccess > 0 {
+		t.Errorf("two incompatible edits both reported success in %d/%d trials", doubleSuccess, trials)
+	}
+}
+
+func TestS2SeparateFilesControl(t *testing.T) {
+	const trials = 50
+	for trial := 0; trial < trials; trial++ {
+		workspace := t.TempDir()
+		for _, name := range []string{"alpha.txt", "beta.txt"} {
+			if err := os.WriteFile(filepath.Join(workspace, name), []byte("old\n"), 0o644); err != nil {
+				t.Fatal(err)
+			}
+		}
+		tool := newEditFile(workspace)
+		edits := []editFileArgs{
+			{Path: "alpha.txt", OldString: "old", NewString: "alpha"},
+			{Path: "beta.txt", OldString: "old", NewString: "beta"},
+		}
+		start := make(chan struct{})
+		var wg sync.WaitGroup
+		for i := range edits {
+			wg.Add(1)
+			go func(i int) {
+				defer wg.Done()
+				<-start
+				raw, _ := json.Marshal(edits[i])
+				res, err := tool.Execute(context.Background(), raw)
+				if err != nil || strings.HasPrefix(res, "error:") {
+					t.Errorf("trial=%d file=%s error=%v result=%s", trial, edits[i].Path, err, res)
+				}
+			}(i)
+		}
+		close(start)
+		wg.Wait()
+		for _, pair := range [][2]string{{"alpha.txt", "alpha\n"}, {"beta.txt", "beta\n"}} {
+			got, err := os.ReadFile(filepath.Join(workspace, pair[0]))
+			if err != nil || string(got) != pair[1] {
+				t.Errorf("trial=%d %s got=%q err=%v", trial, pair[0], got, err)
+			}
+		}
+	}
+	t.Logf("S2_REPLAY separate_path trials=%d completed=%d", trials, trials)
+}
