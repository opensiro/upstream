index 0000000..73f3bdc
--- /dev/null
+++ b/internal/daemon/tools/s2_delegate_replay_test.go
@@ -0,0 +1,67 @@
+package tools
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+)
+
+// syntheticS2Delegator follows the real delegate_task fan-out through the
+// shared Registry.Execute path, but substitutes fixed task goals for a model.
+type syntheticS2Delegator struct {
+	registry *Registry
+	started  sync.WaitGroup
+}
+
+func (d *syntheticS2Delegator) RunTask(ctx context.Context, goal, _, _ string, _ int) (string, error) {
+	d.started.Done()
+	d.started.Wait()
+	args := editFileArgs{Path: "shared.txt", OldString: goal + "=old", NewString: goal + "=new"}
+	raw, err := json.Marshal(args)
+	if err != nil {
+		return "", err
+	}
+	return d.registry.Execute(ctx, "edit_file", raw)
+}
+
+func TestS2DelegatedRegistryReplay(t *testing.T) {
+	const trials = 30
+	var preserved, lost, silentLost int
+	for trial := 0; trial < trials; trial++ {
+		workspace := t.TempDir()
+		path := filepath.Join(workspace, "shared.txt")
+		before := "ALPHA=old\n" + strings.Repeat("x", 1<<20) + "\nBETA=old\n"
+		if err := os.WriteFile(path, []byte(before), 0o644); err != nil {
+			t.Fatal(err)
+		}
+		registry := NewRegistry(workspace, nil, nil)
+		delegator := &syntheticS2Delegator{registry: registry}
+		delegator.started.Add(2)
+		registry.SetDelegator(delegator)
+		out, err := registry.Execute(context.Background(), "delegate_task", json.RawMessage(`{"tasks":[{"goal":"ALPHA"},{"goal":"BETA"}]}`))
+		if err != nil {
+			t.Fatal(err)
+		}
+		after, err := os.ReadFile(path)
+		if err != nil {
+			t.Fatal(err)
+		}
+		both := strings.Contains(string(after), "ALPHA=new") && strings.Contains(string(after), "BETA=new")
+		if both {
+			preserved++
+		} else {
+			lost++
+			if strings.Count(out, "replaced 1 occurrence") == 2 {
+				silentLost++
+			}
+		}
+	}
+	t.Logf("S2_DELEGATED_REGISTRY trials=%d preserved=%d lost=%d silent_lost=%d", trials, preserved, lost, silentLost)
+	if lost > 0 {
+		t.Errorf("delegate_task shared-registry edit collision lost %d/%d edits", lost, trials)
+	}
+}
diff --git a/internal/daemon/tools/s2_replay_test.go b/internal/daemon/tools/s2_replay_test.go
