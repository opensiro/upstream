+++ b/tests/claim-same-cs-race.test.mjs
@@ -0,0 +1,73 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import path from 'node:path';
+import { planClaim, applyClaimPlan, insertActiveWorkRow, parseActiveWorkRows } from '../lib/claim.mjs';
+
+const root = path.join(path.sep, 'p');
+const workboardPath = path.join(root, 'WORKBOARD.md');
+const plannedDir = path.join(root, 'planned');
+const activeDir = path.join(root, 'active');
+const empty = `# WORKBOARD\n\n## Active Work\n\n| CS-Task ID | Title | State | Owner | Branch | Last Updated | Blocked |\n| --- | --- | --- | --- | --- | --- | --- |\n| — | — | — | — | — | — | — |\n\n## Done\n`;
+
+function fixture() {
+  const listing = {
+    entryPath: path.join(plannedDir, 'planned_cs64_my-slug.md'),
+    filename: 'planned_cs64_my-slug.md', cs: 'CS64', slug: 'my-slug', directoryForm: false,
+  };
+  const { plan } = planClaim({
+    csId: 'CS64', listing, workboardMd: empty, workboardPath, plannedDir, activeDir,
+    agentId: 'omni-ah', title: 'The task', today: '2026-10-23',
+  });
+  const files = new Map([[workboardPath, empty], [listing.entryPath, '# Task\n']]);
+  const moves = [];
+  const runner = {
+    exists: p => files.has(p), readFile: p => files.get(p),
+    writeFile: (p, body) => files.set(p, body),
+    gitMv: (src, dest) => {
+      moves.push([src, dest]); files.set(dest, files.get(src)); files.delete(src);
+    },
+  };
+  return { plan, files, moves, runner };
+}
+
+function addRow(md, { cs = 'CS64', owner = 'yoga-ah', branch = 'cs64/content' } = {}) {
+  return insertActiveWorkRow({
+    workboardMd: md,
+    row: { cs, title: 'Concurrent claim', state: '🟢 Active', owner,
+      branch, lastUpdated: '2026-10-23', blocked: '—' },
+  }).md;
+}
+
+test('different owner taking the same CS after plan must not trigger rename or overwrite', () => {
+  const { plan, files, moves, runner } = fixture();
+  const fresh = addRow(empty);
+  files.set(workboardPath, fresh);
+  assert.throws(() => applyClaimPlan({ plan, runner }), /apply-time race.*CS64/);
+  assert.equal(moves.length, 0);
+  assert.equal(files.get(workboardPath), fresh);
+  assert.ok(files.has(plan.sourcePath));
+  assert.ok(!files.has(plan.destPath));
+});
+
+test('same-CS race with different owner stays rejected even when first branch differs', () => {
+  const { plan, files, moves, runner } = fixture();
+  files.set(workboardPath, addRow(empty, { branch: 'cs64/other' }));
+  assert.throws(() => applyClaimPlan({ plan, runner }), /apply-time race.*CS64/);
+  assert.equal(moves.length, 0);
+});
+
+test('different owner claiming a different CS is still permitted', () => {
+  const { plan, files, runner } = fixture();
+  files.set(workboardPath, addRow(empty, { cs: 'CS63', branch: 'cs63/content' }));
+  const result = applyClaimPlan({ plan, runner });
+  assert.equal(result.renamed, true);
+  assert.deepEqual(parseActiveWorkRows(files.get(workboardPath)).map(r => r.cs).sort(), ['CS63', 'CS64']);
+});
+
+test('same owner re-applying an already completed claim remains idempotent', () => {
+  const { plan, runner } = fixture();
+  applyClaimPlan({ plan, runner });
+  const again = applyClaimPlan({ plan, runner });
+  assert.equal(again.renamed, false);
+  assert.equal(again.workboardEdited, false);
+});
