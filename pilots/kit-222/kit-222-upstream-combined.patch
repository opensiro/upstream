+    #[test]
+    fn partial_subagent_harness_allows_config_load_without_selecting_external_backend() {
+        let directory = tempfile::tempdir().unwrap();
+        let path = directory.path().join("config.toml");
+        fs::write(
+            &path,
+            "[acp.claude]\ncommand = 'true'\n\n[subagent.harnesses.\"acp.claude\".models]\nfable = 'example-model'\n",
+        )
+        .unwrap();
+        let original = fs::read_to_string(&path).unwrap();
+        let config = Config::load(&path).expect("partial subagent must not block startup");
+        let (harnesses, selected) = config.harnesses().expect("fallback must be valid");
+        assert_eq!(selected, kit::BUILTIN_HARNESS);
+        assert!(harnesses.contains(kit::BUILTIN_HARNESS));
+        assert_eq!(original, fs::read_to_string(&path).unwrap());
+    }
