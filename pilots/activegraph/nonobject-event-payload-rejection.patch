index 0000000..9c42eae
--- /dev/null
+++ b/tests/test_native_event_payload_object_unittest.py
@@ -0,0 +1,32 @@
+"""Native event-log payload shape regression; never runs LLM behaviors."""
+
+import unittest
+
+from activegraph.store.errors import CorruptedEventPayloadError
+from activegraph.store.serde import decode_payload, encode_payload
+
+
+class NativeEventPayloadShapeTests(unittest.TestCase):
+    def test_valid_object_event_roundtrips(self):
+        expected = {"actor": "worker", "facts": [1, {"nested": True}]}
+        self.assertEqual(decode_payload(encode_payload(expected)), expected)
+
+    def test_syntactically_corrupt_json_is_already_rejected(self):
+        with self.assertRaises(CorruptedEventPayloadError):
+            decode_payload('{"missing":')
+
+    def test_json_array_cannot_replace_event_object(self):
+        with self.assertRaises(CorruptedEventPayloadError):
+            decode_payload('[{"id": "1"}]')
+
+    def test_json_null_cannot_replace_event_object(self):
+        with self.assertRaises(CorruptedEventPayloadError):
+            decode_payload("null")
+
+    def test_json_scalar_cannot_replace_event_object(self):
+        with self.assertRaises(CorruptedEventPayloadError):
+            decode_payload('"not an event payload"')
+
+
+if __name__ == "__main__":
+    unittest.main()
