diff --git a/tests/test_agentuniverse/unit/agent/test_is_supervision_halt.py b/tests/test_agentuniverse/unit/agent/test_is_supervision_halt.py
new file mode 100644
index 0000000..58305b3
--- /dev/null
+++ b/tests/test_agentuniverse/unit/agent/test_is_supervision_halt.py
@@ -0,0 +1,95 @@
+"""Deterministic IS supervision budget gate; never runs a model."""
+
+import asyncio
+from typing import ClassVar
+
+import pytest
+
+from agentuniverse.agent.input_object import InputObject
+from agentuniverse.agent.output_object import OutputObject
+from agentuniverse.agent.template.implementation_agent_template import ImplementationAgentTemplate
+from agentuniverse.agent.template.is_agent_template import ISAgentTemplate
+from agentuniverse.agent.template.supervision_agent_template import SupervisionAgentTemplate
+from agentuniverse.agent.work_pattern.is_work_pattern import ISWorkPattern
+
+
+class _Implementation(ImplementationAgentTemplate):
+    calls: ClassVar[list] = []
+
+    def run(self, **kwargs):
+        type(self).calls.append(kwargs)
+        return OutputObject({"output": "unverified", "checkpoint_output": "unverified"})
+
+    async def async_run(self, **kwargs):
+        return self.run(**kwargs)
+
+
+class _Supervision(SupervisionAgentTemplate):
+    calls: ClassVar[list] = []
+
+    def run(self, **kwargs):
+        type(self).calls.append(kwargs)
+        return OutputObject({"needs_correction": True, "feedback": "must revise", "score": 0})
+
+    async def async_run(self, **kwargs):
+        return self.run(**kwargs)
+
+
+def _run(*, async_mode, halt, max_corrections):
+    implementation, supervision = _Implementation(), _Supervision()
+    _Implementation.calls = []
+    _Supervision.calls = []
+    pattern = ISWorkPattern()
+    pattern.implementation, pattern.supervision = implementation, supervision
+    work_input = {
+        "input": "review this work",
+        "checkpoint_count": 3,
+        "max_corrections": max_corrections,
+        "halt_on_unresolved_correction": halt,
+    }
+    if async_mode:
+        result = asyncio.run(pattern.async_invoke(InputObject({"input": "review this work"}), work_input))
+    else:
+        result = pattern.invoke(InputObject({"input": "review this work"}), work_input)
+    return result, implementation, supervision
+
+
+@pytest.mark.parametrize("async_mode", [False, True])
+def test_opt_in_halt_stops_unresolved_supervision_and_withholds_result(async_mode):
+    result, implementation, supervision = _run(
+        async_mode=async_mode, halt=True, max_corrections=1
+    )
+    context = result["execution_context"]
+    assert len(result["result"]) == 2
+    assert len(implementation.calls) == 3  # first work, one correction, next work
+    assert len(supervision.calls) == 2
+    assert context["halted"] is True
+    assert context["halt_checkpoint"] == 1
+    assert context["halt_reason"] == "UNRESOLVED_SUPERVISION_CORRECTION_LIMIT"
+    assert context["corrections_made"] == 1
+    assert context["checkpoint_history"][-1]["corrected"] is False
+    parsed = ISAgentTemplate().parse_result(result)
+    assert parsed["output"] == ""
+    assert parsed["halted"] is True
+    assert "UNRESOLVED_SUPERVISION_CORRECTION_LIMIT" in parsed["full_output"]
+
+
+@pytest.mark.parametrize("async_mode", [False, True])
+def test_default_continues_without_halt_and_retains_output(async_mode):
+    result, implementation, supervision = _run(
+        async_mode=async_mode, halt=False, max_corrections=0
+    )
+    assert len(result["result"]) == 3
+    assert len(implementation.calls) == 3
+    assert len(supervision.calls) == 3
+    assert not result["execution_context"].get("halted", False)
+    assert ISAgentTemplate().parse_result(result)["output"] == "unverified"
+
+
+def test_is_agent_template_exposes_opt_in_setting():
+    template = ISAgentTemplate()
+    parsed = template.parse_input(
+        InputObject({"input": "review this work", "halt_on_unresolved_correction": True}),
+        {},
+    )
+    assert parsed["halt_on_unresolved_correction"] is True
